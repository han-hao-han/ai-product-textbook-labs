{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "form_extraction_v1.json",
  "title": "中文表单视觉结构化识别结果",
  "type": "object",
  "additionalProperties": false,
  "required": ["fields", "warnings"],
  "properties": {
    "fields": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "value"],
        "properties": {
          "key": {"type": "string"},
          "value": {"type": "string"}
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {"type": "string"}
    }
  }
}
