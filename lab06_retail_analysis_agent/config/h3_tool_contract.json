            "title": "Start Date"
          },
          "end_date": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "custom期间的结束日期（YYYY-MM-DD，含当日）；其他期间必须为null。",
            "title": "End Date"
          },
          "comparison": {
            "const": "united_kingdom_vs_other",
            "description": "冻结支持的两分段比较：英国与英国以外。",
            "title": "Comparison",
            "type": "string"
          }
        },
        "required": [
