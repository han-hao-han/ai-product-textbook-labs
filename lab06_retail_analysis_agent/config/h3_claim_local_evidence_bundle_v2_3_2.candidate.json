  "deterministic_grouping_rules": [
    {
      "rule_id": "BUNDLE-GROUP-01",
      "bundle_kind": "selection_limit",
      "condition": "FACT metric is top_n",
      "result": "Create one selection_limit atom bound to that FACT reference."
    },
    {
      "rule_id": "BUNDLE-GROUP-02",
      "bundle_kind": "ranked_entity",
      "condition": "FACTs share call_id, rank, dimensions, period and date range",
      "result": "Group identity, rank and existing metric FACTs without calculating or comparing values."
    },
    {
      "rule_id": "BUNDLE-GROUP-03",
      "bundle_kind": "aggregate_metric",
      "condition": "A non-ranked FACT carries a report-admissible metric value",
      "result": "Create metric and period atoms referencing the original FACT."
    },
    {
      "rule_id": "BUNDLE-GROUP-04",
      "bundle_kind": "request_parameter",
      "condition": "A validated RequestRecord exists",
      "result": "Create one request atom; do not infer missing user parameters."
    },
    {
      "rule_id": "BUNDLE-GROUP-05",
      "bundle_kind": "policy_boundary",
      "condition": "A current policy record exists",
      "result": "Create one policy atom; preserve the exact frozen policy message."
    },
    {
      "rule_id": "BUNDLE-GROUP-06",
      "bundle_kind": "cross_tool_observation",
      "condition": "Facts from different calls have an explicit deterministic dependency or identical admissible period/dimension join key",
      "result": "Group existing references only; never derive a new metric or causal relation."
    }
  ],
  "bundle_usage_contract": {
    "model_may_choose_which_supported_claims_to_write": true,
    "model_may_combine_multiple_atoms_in_one_claim": true,
    "combined_claim_requires_union_of_atom_evidence_in_same_claim": true,
    "reusing_a_number_in_another_claim_requires_repeating_its_evidence": true,
    "evidence_in_another_claim_does_not_satisfy_current_claim": true,
    "model_may_write_numeric_free_advice_subject_to_manual_review": true,
    "model_may_not_copy_bundle_id_into_report": true,
    "model_may_not_calculate_new_values": true,
    "existing_report_validator_remains_final_authority": true
  },
